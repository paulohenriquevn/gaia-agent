# Obrigatória — chave do OpenRouter usada pelo agente e pelas ferramentas multimodais
OPENROUTER_API_KEY=

# Opcionais — modelos
MODEL_ID=openrouter/anthropic/claude-sonnet-5
VISION_MODEL=google/gemini-2.5-flash
AUDIO_MODEL=google/gemini-2.5-flash

# Necessárias apenas para submeter FORA do Space.
# Dentro do Space, ambas são derivadas automaticamente de SPACE_ID.
# AGENT_CODE_URL é o link do código: https://huggingface.co/spaces/<user>/<space>/tree/main
HF_USERNAME=
AGENT_CODE_URL=

CONCURRENCY=3
FALLBACK_MODEL_ID=openrouter/google/gemini-3-flash-preview
MAX_ITERATIONS=30
