{
  "name": "gaia-final-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "eval": "node --env-file-if-exists=.env --experimental-strip-types src/cli/evaluate.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "submit": "node --env-file-if-exists=.env --experimental-strip-types src/cli/submit.ts",
    "smoke": "node --env-file-if-exists=.env --experimental-strip-types src/cli/smoke.ts",
    "score": "node --env-file-if-exists=.env --experimental-strip-types src/cli/score.ts"
  },
  "dependencies": {
    "@theokit/sdk": "^4.53.1",
    "cheerio": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
